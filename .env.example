# API — copy to `.env` (gitignored) and adjust.

PORT=5000
NODE_ENV=development

# The web app's origin (CORS + Better Auth trusted origin).
FRONTEND_URL=http://localhost:5173

# Postgres. Locally (Homebrew `postgresql@18`) the user is your macOS login with no password:
#   postgresql://<you>@localhost:5432/critpath
# `pnpm db:migrate` creates the database if it is missing.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/critpath

# Better Auth — generate the secret with `openssl rand -base64 32`.
# BETTER_AUTH_URL is the public origin the API is reached at. Deployed behind the web app's
# Cloudflare Worker (critpath-fe/worker/index.ts), that is the web app's origin.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000

# Optional: Google sign-in. Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The key critpath-fe's Cloudflare Worker sends with the visitor's address (lib/rate-limit.ts). Unset
# = the API never believes that header and reads X-Forwarded-For, as locally. Generate it with
# `openssl rand -base64 32`; the same value is the Worker's secret EDGE_PROXY_SECRET.
EDGE_PROXY_SECRET=

# Who may create an account (comma-separated). Unset = anyone.
ALLOWED_SIGNUP_EMAILS=

# Uploads (profile photos, and any files you add) go to a Cloudflare R2 bucket when all four R2_* values are set (production), and to
# UPLOAD_DIR on disk otherwise (local development; default ./uploads). Setting some but not all of
# them stops the API at startup. The token needs Object Read & Write on that one bucket.
# R2_ENDPOINT is optional: an EU-jurisdiction bucket or a local S3 stand-in.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
UPLOAD_DIR=

# Nightly database backup to R2 (lib/backup.ts): true or false (unset = false). Production
# only: needs the four R2_* above, and locally those name the production bucket. Optional: the UTC
# hour it becomes due (3), how many to keep (30), and a different bucket the same token can write.
# Runs `pg_dump`, which must be installed (at least the server's major version), or set
# PG_DUMP_PATH to it.
BACKUP_ENABLED=
BACKUP_HOUR_UTC=
BACKUP_KEEP=
BACKUP_BUCKET=
PG_DUMP_PATH=

# "true" enables DELETE /api/users/me (account deletion). `pnpm smoke` needs it, to delete the
# user it creates.
ALLOW_ACCOUNT_DELETION=

# Optional: real email via Resend. Unset = emails (e.g. password reset) print to the console.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# The product name and public site that emails show (lib/emails.ts).
APP_NAME=
SITE_URL=

# Optional: Discord channel webhooks (Edit Channel → Integrations → Webhooks), lib/discord.ts.
# SIGNUPS gets every new account (name, email, how they signed up); OPS gets failures no user can
# fix (a refused email, a failed backup, a 500, a crash), one per kind per six hours.
# Each unset = that one silent. Sent only when NODE_ENV=production unless the third is "true".
# The URLs are credentials: anyone with one can post to the channel. `pnpm discord:check [ops]`.
DISCORD_WEBHOOK_SIGNUPS=
DISCORD_WEBHOOK_OPS=
DISCORD_NOTIFY_NON_PRODUCTION=

# critpath-ai, the Python service that answers questions about stored schedules (its own repo).
# Unset = POST /api/ai/chat answers 503 AI_DISABLED. Locally: http://127.0.0.1:8000.
AI_SERVICE_URL=
# The same value as critpath-ai's AI_SERVICE_TOKEN (`openssl rand -base64 32`); optional locally.
AI_SERVICE_TOKEN=
